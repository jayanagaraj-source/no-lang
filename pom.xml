<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven POM for the no-lang fixture. INTENTIONALLY uses vulnerable versions. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.nolang</groupId>
  <artifactId>no-lang</artifactId>
  <version>0.0.1</version>

  <!-- Insecure: repository over plain HTTP -->
  <repositories>
    <repository>
      <id>insecure-mirror</id>
      <url>http://repo.example.com/maven2</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Log4Shell: CVE-2021-44228 / GHSA-jfh8-c2jp-5v3q -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>

    <!-- Text4Shell: CVE-2022-42889 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.9</version>
    </dependency>
  </dependencies>
</project>
